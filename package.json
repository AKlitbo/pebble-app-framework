{
  "name": "pebble-watchface-engine",
  "author": "Null Syntax",
  "version": "1.1.0",
  "description": "The shared engine behind my Pebble watchfaces, mounted as a submodule at lib/.",
  "license": "AGPL-3.0-or-later OR PolyForm-Noncommercial-1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "test": "vitest run --config config/vitest.config.ts",
    "lint": "eslint . --config config/eslint.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p config/tsconfig.builder.json && tsc -p config/tsconfig.tools.json && tsc -p config/tsconfig.spec.json",
    "build:conditions": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/build-conditions.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rebble/clay": "1.1.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.8",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "ical.js": "^2.2.1",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "sharp": "^0.35.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.8"
  }
}
