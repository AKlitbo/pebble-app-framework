import os.path
import sys
from waflib.Tools import c_preproc

# where the sources sit, each relative to the repo root two levels up (this folder sits under targets/)
SOURCE = {
    'engine': '{{ENGINE_DIR}}',
    'face': '{{FACE_DIR}}',
    'family_core': '{{FAMILY_CORE_DIR}}',
}

# what this target installs as. an app target compiles with -DBUILD_WATCHAPP, which is how a face
# guards the code it only wants when it opens from the launcher
WATCHFACE = {{WATCHFACE}}

# let waf's preprocessor scanner trace through absolute include paths so it discovers
# the transitive pebble.h include and the SDK can inject the resource_ids.auto.h
# dependency before compilation starts
c_preproc.go_absolute = True

top = '.'
out = 'build'


def options(ctx):
    ctx.load('pebble_sdk')


def configure(ctx):
    ctx.load('pebble_sdk')


def build(ctx):
    # load the shared waf helpers from the engine at the repo root. the staged copy of the engine
    # here does not exist until stage_shared_sources runs, so load from the real one
    helpers = os.path.join(ctx.path.parent.parent.abspath(), SOURCE['engine'], 'py')
    if helpers not in sys.path:
        sys.path.insert(0, helpers)

    import waf_helpers

    # stage before loading the SDK: pebble_sdk scans resources/ as it loads, so the
    # shared sources have to be in place first
    waf_helpers.stage_shared_sources(ctx, SOURCE)

    ctx.load('pebble_sdk')

    waf_helpers.build_conditions(ctx, SOURCE)
    waf_helpers.build_face(ctx, SOURCE, [] if WATCHFACE else ['-DBUILD_WATCHAPP'])
