// typechecks the docs site tools and their specs
// they import marked from the docs package's own install, so they are checked apart from the framework's own projects
// run by npm --prefix docs run typecheck and by the framework's CI after npm ci --prefix docs
{
  "extends": "../src/tsconfig.json",
  "compilerOptions": {
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["tools/**/*.ts", "vitest.config.ts", "eslint.config.ts"]
}
