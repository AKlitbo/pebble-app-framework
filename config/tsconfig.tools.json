// typechecks the build and generator scripts plus the configs in here
// run by npm run typecheck. these run under node so they never ship to the watch
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "../tools/**/*.ts",
    "../config/**/*.ts",
    "../../src/tools/**/*.ts",
    "../../src/pkjs/clay/builder/*.manifest.ts",
    "../../watchfaces/**/tools/**/*.ts",
    "../../watchfaces/**/pkjs/clay/builder/*.manifest.ts"
  ],
  "exclude": ["../../node_modules", "../../targets", "../../**/*.spec.ts"]
}
