{
  "$schema": "https://typedoc.org/schema.json",
  "name": "Pebble App Framework: Phone API",
  "entryPoints": ["../ts"],
  "entryPointStrategy": "expand",
  "exclude": ["../ts/**/*.spec.ts", "../ts/**/*.d.ts", "../ts/clay/builder/**", "../ts/testing/**"],
  "tsconfig": "../tsconfig.json",
  "out": "../docs/site/dist/ts",
  "readme": "none",
  "excludeInternal": true,
  "intentionallyNotExported": ["AppMessageDict"],
  "treatWarningsAsErrors": true,
  "customCss": "../docs/typedoc/pebble.css"
}
