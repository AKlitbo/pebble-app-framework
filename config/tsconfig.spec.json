// typechecks the *.spec.ts suite
// run by npm run typecheck
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noImplicitAny": false,
    "strictNullChecks": false,
    // the specs run in jsdom so they need the DOM types
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  // the framework's own specs, then the faces of a repo mounting it at lib/, at its root or under watchfaces/
  // the two .d.ts files declare globals the specs use without importing them
  "include": [
    "../**/*.spec.ts",
    "../../src/**/*.spec.ts",
    "../../watchfaces/**/*.spec.ts",
    "../ts/pkjs/pebble.d.ts",
    "../../src/pkjs/generated.d.ts",
    "../../watchfaces/**/src/pkjs/generated.d.ts"
  ],
  // the docs site specs import packages only the docs install has, so docs/tsconfig.json checks them
  "exclude": [
    "../node_modules",
    "../../node_modules",
    "../../targets",
    "../docs"
  ]
}
