// points an editor at the framework's builder, spec, and tools projects, since it only looks for a
// tsconfig.json above the file it opens, and the one it finds first, src/tsconfig.json, covers only the
// runtime in src/ts/
// it holds no files of its own, and npm run typecheck checks each project on its own
{
  "files": [],
  "references": [
    { "path": "./tsconfig.builder.json" },
    { "path": "./tsconfig.spec.json" },
    { "path": "./tsconfig.tools.json" }
  ]
}
