{
  "compilerOptions": {
    "target": "ES2015",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["../src/pkjs/**/*.ts", "../watchfaces/**/src/pkjs/**/*.ts", "ts/**/*.ts"],
  "exclude": [
    "../node_modules",
    "../targets",
    "../src/pkjs/clay/builder/**",
    "../watchfaces/**/src/pkjs/clay/builder/**",
    "ts/clay/builder/**",
    "../**/*.spec.ts"
  ]
}
