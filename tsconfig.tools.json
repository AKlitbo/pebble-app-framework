// typechecks the framework's build and generator scripts plus the configs beside this one, with
// the same options a face's tools extend
// run by npm run typecheck. these run under node so they never ship to the watch
// the dev plugin's fixture faces are phone code, which the page check compiles with the phone's options
{
  "extends": "./src/tsconfig.tools.json",
  "include": ["tools/**/*.ts", "*.config.ts", "src/tools/**/*.ts", "src/plugins/**/*.ts"],
  "exclude": ["node_modules", "**/*.spec.ts", "src/plugins/dev/fixtures/*/src/**"]
}
